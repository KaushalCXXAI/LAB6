@model List<LAB6.Models.Productmodel>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Product</title>
</head>
<body>
    <div>
        <table border="1">
            <tr>
                <td>name</td>
                <td>category</td>
                <td>price</td>
                <td>actions</td>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>$@item.Price</td>
                    <td>@Html.ActionLink("View Details", "Details", new { id = @item.Id })</td>
                </tr>
            }
        </table>
    </div>
</body>
</html>
